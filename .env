DOCKER_IMAGE=godot
DOCKER_TEST_ARGS="--env GODOT_VERSION=4 --env BLENDER_VERSION=4"
DOCKER_TEST_ARGS_LINUX="-v \"godot-binaries:/godot/binaries\" -v \"godot-templates:/root/.local/share/godot/export_templates\""
DOCKER_TEST_ARGS_WINDOWS="-v \"godot-binaries:C:/godot/binaries\" -v \"godot-templates:C:/Users/ContainerAdministrator/AppData/Roaming/Godot/export_templates\""
DOCKER_TEST_CMD="godot --version"
