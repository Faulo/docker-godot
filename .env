DOCKER_IMAGE=godot
DOCKER_TEST_ARGS="--env GODOT_VERSION=4 --env BLENDER_VERSION=4"
DOCKER_TEST_ARGS_LINUX="-v \"godot-binaries:/godot/binaries\" -v \"godot-templates:/godot/export_templates\" -v \"blender:/blender\""
DOCKER_TEST_ARGS_WINDOWS="-v \"godot-binaries:C:/godot/binaries\" -v \"godot-templates:C:/godot/export_templates\" -v \"blender:C:/blender\""
DOCKER_TEST_CMD="godot --version"
