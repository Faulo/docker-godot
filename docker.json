{
    "schemaVersion": 3,
    "namespace": "$DOCKER_NAMESPACE",
    "image": "$DOCKER_IMAGE",
    "description": "Godot and optional Blender with reusable downloads for Linux and Windows containers",
    "overviewFile": "README.md",
    "context": ".",
    "matrix": {
        "product": {
            "tags": {
                "latest": {}
            }
        },
        "os": {
            "dockerfile": "{{matrix.os}}/Dockerfile",
            "tags": {
                "linux": {
                    "runner": "ubuntu-latest",
                    "matrix": {
                        "architecture": {
                            "tags": {
                                "amd64": {}
                            }
                        }
                    }
                },
                "windows": {
                    "runner": "windows-latest",
                    "matrix": {
                        "release": {
                            "tags": {
                                "ltsc2019": {}
                            }
                        }
                    }
                }
            }
        }
    }
}
